      ],
      "envVariables": {
        "SUPABASE_URL": "https://pzhblcoszvkbnmolkkxf.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_AT0jjmkKEHk3PJThm9aG1w_q2hSfV4y",
        "PORT": "4501",
        "TENCENTCLOUD_RUNENV": "SCF"
